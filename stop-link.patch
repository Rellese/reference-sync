index 82f0f3d..55b7ac1 100644
--- a/js/stop-link.js
+++ b/js/stop-link.js
@@ -211,3 +211,205 @@ export function sameStopPublication(
     normalizeId(right.publicationId)
   );
 }
+
+function cleanPostId(value) {
+  return clean(value)
+    .replace(/^[a-z0-9_-]+:/i, '')
+    .replace(/^\/+|\/+$/g, '');
+}
+
+function postSourceCode(post) {
+  const source = clean(
+    post?.source ??
+    post?.sourceCode ??
+    post?.platform,
+  ).toLowerCase();
+
+  if (source) return source;
+
+  const postId = clean(post?.postId);
+  const separator = postId.indexOf(':');
+
+  return separator > 0
+    ? postId.slice(0, separator).toLowerCase()
+    : '';
+}
+
+function publicationCandidates(post) {
+  const values = [
+    post?.externalId,
+    post?.publicationId,
+    post?.shortcode,
+    post?.code,
+    post?.id,
+    post?.postId,
+    post?.raw?.post_id,
+    post?.raw?.id,
+    post?.raw?.pk,
+    post?.raw?.shortcode,
+    post?.raw?.code,
+  ];
+
+  return new Set(
+    values
+      .map(cleanPostId)
+      .filter(Boolean),
+  );
+}
+
+export function postMatchesStopLink(post, stopLink) {
+  if (!post || !stopLink?.ok) return false;
+
+  const sourceCode = postSourceCode(post);
+
+  if (
+    sourceCode &&
+    sourceCode !== stopLink.sourceCode
+  ) {
+    return false;
+  }
+
+  const expectedId = cleanPostId(
+    stopLink.publicationId,
+  );
+
+  if (
+    expectedId &&
+    publicationCandidates(post).has(expectedId)
+  ) {
+    return true;
+  }
+
+  const urls = [
+    post?.url,
+    post?.postUrl,
+    post?.canonicalUrl,
+    post?.webpageUrl,
+    post?.raw?.post_url,
+    post?.raw?.canonical_url,
+    post?.raw?.webpage_url,
+    post?.raw?._metadataUrl,
+  ];
+
+  for (const value of urls) {
+    const url = clean(value);
+    if (!url) continue;
+
+    const parsed = parseStopLink(
+      url,
+      stopLink.sourceCode,
+    );
+
+    if (
+      parsed.ok &&
+      sameStopPublication(parsed, stopLink)
+    ) {
+      return true;
+    }
+  }
+
+  return false;
+}
+
+function postOccurrences(post) {
+  if (
+    Array.isArray(post?.collectionOccurrences) &&
+    post.collectionOccurrences.length
+  ) {
+    return post.collectionOccurrences
+      .map((occurrence) => ({
+        ...occurrence,
+        collectionId: clean(
+          occurrence?.collectionId,
+        ),
+      }))
+      .filter((occurrence) =>
+        Boolean(occurrence.collectionId));
+  }
+
+  const collectionId = clean(
+    post?.collectionId,
+  );
+
+  if (!collectionId) return [];
+
+  return [{
+    occurrenceId:
+      clean(post?.occurrenceId) ||
+      `${collectionId}:${clean(post?.postId)}`,
+
+    collectionId,
+    collectionName:
+      clean(post?.collectionName),
+
+    collectionType:
+      clean(post?.collectionType),
+
+    parentId:
+      clean(post?.collectionParentId),
+
+    parentName:
+      clean(post?.collectionParentName),
+
+    isDuplicate: false,
+  }];
+}
+
+function cloneWithOccurrences(post, occurrences) {
+  const first = occurrences[0];
+
+  return {
+    ...post,
+
+    collectionId:
+      first?.collectionId || '',
+
+    collectionName:
+      first?.collectionName || '',
+
+    collectionType:
+      first?.collectionType || '',
+
+    collectionParentId:
+      first?.parentId || '',
+
+    collectionParentName:
+      first?.parentName || '',
+
+    collectionOccurrences:
+      occurrences.map((occurrence) => ({
+        ...occurrence,
+      })),
+  };
+}
+
+/*
+ * В обычном режиме порядок posts считается порядком выдачи:
+ * от новых публикаций к старым.
+ *
+ * В папочном режиме граница применяется отдельно к каждому
+ * collectionId. Остальные папки продолжают выдачу независимо.
+ */
+export function applyStopLinkBoundary(
+  posts,
+  stopLink,
+  {
+    folderSearch = false,
+  } = {},
+) {
+  const sourcePosts = Array.isArray(posts)
+    ? posts
+    : [];
+
+  if (!stopLink?.ok) {
+    return [...sourcePosts];
+  }
+
+  if (!folderSearch) {
+    const boundaryIndex = sourcePosts.findIndex(
+      (post) =>
+        postMatchesStopLink(post, stopLink),
+    );
+
+    return boundaryIndex < 0
+      ? [...sourcePosts]
+      : sourcePosts.slice(0, boundaryIndex);
+  }
+
+  const stoppedCollections = new Set();
+  const result = [];
+
+  for (const post of sourcePosts) {
+    const occurrences = postOccurrences(post);
+    const matchesBoundary =
+      postMatchesStopLink(post, stopLink);
+
+    /*
+     * Старые публикации удаляются только из тех папок,
+     * где граница уже была найдена.
+     */
+    const availableOccurrences =
+      occurrences.filter(
+        (occurrence) =>
+          !stoppedCollections.has(
+            occurrence.collectionId,
+          ),
+      );
+
+    if (matchesBoundary) {
+      /*
+       * Сама граничная публикация не попадает в результат.
+       * Останавливаются только её папочные вхождения.
+       */
+      for (const occurrence of availableOccurrences) {
+        stoppedCollections.add(
+          occurrence.collectionId,
+        );
+      }
+
+      continue;
+    }
+
+    if (!occurrences.length) {
+      result.push(post);
+      continue;
+    }
+
+    if (!availableOccurrences.length) {
+      continue;
+    }
+
+    if (
+      availableOccurrences.length ===
+      occurrences.length
+    ) {
+      result.push(post);
+      continue;
+    }
+
+    result.push(
+      cloneWithOccurrences(
+        post,
+        availableOccurrences,
+      ),
+    );
+  }
+
+  return result;
+}
